<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mohammed-Game-Update.exe: the small bridge that v40-v42 download instead of the whole installer (see Program.cs).
       .NET Framework 4.6.2 is part of Windows 10/11, so the exe is only a few hundred KB. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Mohammed-Game-Update</AssemblyName>
    <RootNamespace>MGBridge</RootNamespace>
    <ApplicationIcon>../../assets/icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Mohammed Game</Product>
    <AssemblyTitle>Mohammed Game</AssemblyTitle>
    <Company>Mohammed</Company>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="msg_*.png" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="audiowide_lat.ttf" LogicalName="audiowide.ttf" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
