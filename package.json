{
  "name": "mohammed-game",
  "productName": "Mohammed Game",
  "version": "17.0.0",
  "description": "Mohammed Game",
  "author": "Mohammed",
  "main": "main.js",
  "build": {
    "appId": "com.mohammed.game",
    "productName": "Mohammed Game",
    "files": [
      "main.js",
      "preload.js",
      "updater.html",
      "game/**",
      "fonts/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mohammed Game",
      "runAfterFinish": true,
      "artifactName": "Mohammed-Game-Setup.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mymohammed2006-jpg",
        "repo": "Mohammed-Game",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "en-US",
      "ar"
    ]
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "private": true
}